# Copy to .env and adjust as needed. All keys are prefixed with TRACKA_ (see src/app/config.py).
TRACKA_QDRANT_URL=http://localhost:6333
TRACKA_QDRANT_COLLECTION=documents
TRACKA_DENSE_VECTOR_SIZE=384
TRACKA_EMBEDDING_BACKEND=fastembed
TRACKA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TRACKA_SPARSE_HASH_BUCKETS=65536
TRACKA_CHUNK_TARGET_TOKENS=250
TRACKA_CHUNK_OVERLAP_TOKENS=50
TRACKA_RRF_K=60
TRACKA_DENSE_DISTANCE=Cosine
TRACKA_SPARSE_INDEX_ON_DISK=false
TRACKA_SPARSE_MODIFIER=IDF
