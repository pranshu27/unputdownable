# Azure OpenAI — copy to .env and fill in. Never commit the real .env.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_BASE=https://your-resource.openai.azure.com/
AZURE_DEPLOYMENT=gpt5-mini
AZURE_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_MODEL=gpt-5-mini
PORT=3001

# --- RAG vector store ---
# Connection string to a Postgres with the pgvector extension enabled.
POSTGRES_URL=postgresql://user:password@host:5432/db?sslmode=require
# "pgvector" to use the vector DB, "memory" for the offline/deterministic in-process store.
RAG_BACKEND=memory
# Optional Azure embedding deployment (e.g. text-embedding-3-small). Falls back to hashing.
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Observability / tracing (optional) ---
# Set both keys to stream traces to Langfuse. Leave blank to disable (no-op).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
