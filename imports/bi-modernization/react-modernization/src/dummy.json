      "implementation_notes": "SELECT PLCY_ID_SK as PLCY_ID_SK, CEA_PLCY_ID_SK as CEA_PLCY_ID_SK FROM (SELECT PLCY_ID_SK as PLCY_ID_SK, CEA_PLCY_ID_SK as CEA_PLCY_ID_SK FROM FDR.FDR_FIRE_PLCY_DEPENDENT a, STG.STG_TFPLCY_TRAN_RESULT b where a.DEPNDNT_PLCY_NUM = b.POLICY_NUMBER UNION SELECT PLCY_ID_SK as PLCY_ID_SK, CEA_PLCY_ID_SK as CEA_PLCY_ID_SK FROM FDR.PRE_FDR_FIRE_PLCY_DEPENDENT c, STG.STG_TFPLCY_TRAN_RESULT d where c.DEPNDNT_PLCY_NUM = d.POLICY_NUMBER) BB ORDER BY CEA_PLCY_ID_SK"
