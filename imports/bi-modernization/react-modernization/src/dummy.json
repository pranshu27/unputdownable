      "name": "lkp_FDR_FIRE_PROP_STRUCTURE_MAJOR_SOI_ID_TRNS_RSLT",
      "calculation_description": "This lookup procedure enriches the transformation process by retrieving policy and source system information based on specific conditions. It uses a complex SQL override to fetch data from multiple tables, ensuring that the correct policy identifiers are matched and returned.",
      "implementation_notes": "SELECT X.SOI_ID as SOI_ID, X.PLCY_ID_SK as PLCY_ID_SK, X.SRC_SYS_CD as SRC_SYS_CD FROM ((SELECT A.SOI_ID as SOI_ID, A.PLCY_ID_SK as PLCY_ID_SK, CASE WHEN A.SRC_SYS_CD='AFL' THEN 'FL' WHEN A.SRC_SYS_CD='AFO' THEN 'FO' ELSE A.SRC_SYS_CD END as SRC_SYS_CD FROM $$FDR.FDR_FIRE_PROP_STRUCTURE A WHERE A.PLCY_ID_SK in (SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK union SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.PRE_FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.PRE_FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK ) UNION SELECT B.SOI_ID as SOI_ID, B.PLCY_ID_SK as PLCY_ID_SK, CASE WHEN B.SRC_SYS_CD='AFL' THEN 'FL' WHEN B.SRC_SYS_CD='AFO' THEN 'FO' ELSE B.SRC_SYS_CD END as SRC_SYS_CD FROM $$FDR.PRE_FDR_FIRE_PROP_STRUCTURE B WHERE B.PLCY_ID_SK in (SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK UNION SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.PRE_FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.PRE_FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK))) AS X UNION SELECT X.SOI_ID as SOI_ID, X.PLCY_ID_SK as PLCY_ID_SK, X.SRC_SYS_CD as SRC_SYS_CD FROM ((SELECT A.SOI_ID as SOI_ID, A.PLCY_ID_SK as PLCY_ID_SK, A.SRC_SYS_CD as SRC_SYS_CD FROM $$FDR.FDR_FIRE_SOI_MBLHM A WHERE A.PLCY_ID_SK in (SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK union SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.PRE_FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.PRE_FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK) UNION SELECT B.SOI_ID as SOI_ID, B.PLCY_ID_SK as PLCY_ID_SK, B.SRC_SYS_CD as SRC_SYS_CD FROM $$FDR.PRE_FDR_FIRE_SOI_MBLHM B WHERE B.PLCY_ID_SK in (SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK UNION SELECT coalesce(CP.PLCY_ID_SK, AA.PLCY_ID_SK) FROM (select PP.PLCY_ID_SK from $$FDR.PRE_FDR_PARENT_PLCY PP where PP.SRC_SYS_PLCY_NUM in (select POLICY_NUMBER from $$STG.STG_TFPLCY_TRAN_RESULT) and PP.LOB_CD = 'F') AA LEFT OUTER JOIN $$FDR.PRE_FDR_FIRE_PLCY_DEPENDENT CP ON AA.PLCY_ID_SK = CP.CEA_PLCY_ID_SK))) AS X"
    },
    {
      "name": "lkp_FDR_FIRE_PLCY_TRANS_RSLT_MIN_EFF_DT",
      "calculation_description": "This lookup will help calculate min_eff_dt.",
      "implementation_notes": "SELECT a.PLCY_ID_SK as PLCY_ID_SK, MIN(a.EFF_DT) as EFF_DT FROM FDR.FDR_FIRE_PLCY_TRANS_RSLT a GROUP BY a.PLCY_ID_SK"
