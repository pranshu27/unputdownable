      "implementation_notes": "SELECT A.PLCY_ID_SK AS PLCY_ID_SK, A.TRANS_TMSP AS TRANS_TMSP, A.EFF_DT AS EFF_DT, A.FACESHEET_PRNT_DT AS FACESHEET_PRNT_DT FROM $$FDR.FDR_FIRE_PLCY_TRANS_RSLT A WHERE A.PLCY_ID_SK IN (SELECT PLCY_ID_SK FROM $$FDR.FDR_PARENT_PLCY B WHERE B.SRC_SYS_PLCY_NUM IN (SELECT POLICY_NUMBER FROM $$STG.STG_TFPLCY_TRAN_RESULT))"
