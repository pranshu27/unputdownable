    {
      "name": "lkp_WORKFLOW_RUN_ID_ABC",
      "calculation_description": "This lookup procedure retrieves the WORKFLOW_RUN_ID from the ABC_AUDIT_WRKFL_RUN table based on the current workflow name. It uses a SQL override to fetch the maximum WORKFLOW_RUN_ID for workflows that are currently running.",
      "implementation_notes": "SELECT WRKFL_NM AS WORKFLOW_NAME, MAX(WRKFL_RUN_ID) AS WORKFLOW_RUN_ID FROM ABC.ABC_AUDIT_WRKFL_RUN R, ABC.ABC_CTRL_WRKFL_PRMTR P WHERE P.WRKFL_NM ='$PMWorkflowName' AND R.WRKFL_ID = P.WRKFL_ID AND WRKFL_STAT='Running' GROUP BY WRKFL_NM"
    },
