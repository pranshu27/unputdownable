# Azure OpenAI
AZURE_OPENAI_API_BASE=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Alation
ALATION_BASE_URL=https://your-instance.alationcloud.com
ALATION_API_TOKEN=SV-your-api-token-here
ALATION_GLOSSARY_ID=1
ALATION_VERIFY_SSL=true

# Pipeline behaviour
LINKER_CONFIDENCE_THRESHOLD=60
LINKER_CACHE_HOURS=24
LINKER_CACHE_DIR=./cache

# PostgreSQL — KPI rationalization catalog
# Use POSTGRES_URL for a single connection string (takes precedence),
# or set the individual fields below.
POSTGRES_URL=postgresql://user:password@host:5432/dbname
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=your-db
# POSTGRES_USER=your-user
# POSTGRES_PASSWORD=your-password
POSTGRES_SCHEMA=public
